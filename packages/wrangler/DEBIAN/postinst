#!/bin/sh
set -e

WRANGLER_VERSION="4.123.0"

echo "Installing wrangler@${WRANGLER_VERSION} via npm..."
npm install -g --ignore-scripts "wrangler@${WRANGLER_VERSION}"

# Stub workerd/lib/main.js to prevent 'Unsupported platform: android arm64 LE' error on import
WORKERD_MAIN="$PREFIX/lib/node_modules/wrangler/node_modules/workerd/lib/main.js"
if [ -f "$WORKERD_MAIN" ]; then
    cat > "$WORKERD_MAIN" << 'WORKERD_EOF'
exports.binPath = "/bin/true";
WORKERD_EOF
fi

# Install our wrapper that blocks 'wrangler dev'
WRAPPER="$PREFIX/bin/wrangler-wrapper"
cat > "$WRAPPER" << 'WRAPPER_EOF'
#!/bin/sh
if [ "${1:-}" = "dev" ]; then
    echo "error: 'wrangler dev' is not supported on Termux." >&2
    echo "The local development server requires workerd, which does not ship" >&2
    echo "Android binaries. Use 'wrangler deploy' to deploy directly," >&2
    echo "or 'wrangler tail' to stream logs from a deployed worker." >&2
    exit 1
fi
exec node "$PREFIX/lib/node_modules/wrangler/bin/wrangler.js" "$@"
WRAPPER_EOF
chmod 755 "$WRAPPER"

# Replace the npm-installed wrangler binary symlink with our wrapper
rm -f "$PREFIX/bin/wrangler"
cp "$WRAPPER" "$PREFIX/bin/wrangler"

echo "wrangler ${WRANGLER_VERSION} installed."
echo "  wrangler deploy    - deploy a worker"
echo "  wrangler tail      - stream live logs"
echo "  wrangler pages     - manage Pages projects"
echo "  wrangler dev       - NOT SUPPORTED (use deploy instead)"
