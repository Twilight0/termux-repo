#!/bin/sh
set -e

YT_TUI_VERSION="1.1.0"

echo "Installing yt-tui ${YT_TUI_VERSION} from Twilight0/yt-tui..."
pip install --upgrade "git+https://github.com/Twilight0/yt-tui.git@v${YT_TUI_VERSION}"

echo ""
echo "yt-tui installed."
echo "  Run 'yt-tui' to start the interface"
echo "  Needs ffmpeg to merge video+audio (pulled in as a dependency)"
